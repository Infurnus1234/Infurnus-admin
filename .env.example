# Public, non-secret backend origin. Next.js embeds this at build time.
# Remote main leaves the backend origin unset; set approved values per environment.
# NEXT_PUBLIC_API_URL=https://your-approved-backend-host
# Server-side backend origin for the authenticated proxy (same backend).
# BACKEND_API_URL=https://your-approved-backend-host
# Exact public Admin origin; configure per environment for strict mutation-origin checks.
# ADMIN_APP_ORIGIN=https://your-approved-admin-host
# Optional only when the backend uses non-default authentication cookie names:
# AUTH_REFRESH_COOKIE_NAME=infurnus_refresh_token
# AUTH_CSRF_COOKIE_NAME=infurnus_csrf_token
# Copy to .env.local for development and override only for your own backend.
# Set this in Vercel Production; rebuild after any change.
# No JWT secrets, passwords, database URLs or private keys belong here.
